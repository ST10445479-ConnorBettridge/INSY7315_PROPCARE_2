const express = require('express');
const { authenticate, authorize } = require('../middleware/auth');
const { q } = require('../db');
const { AppError } = require('../middleware/errorHandler');
const logger = require('../utils/logger');

const router = express.Router();

const NOTIFY_CHANNELS = ['In-app push + email', 'In-app push only', 'Email only'];

const SETTING_KEYS = {
  orgName: 'org_name',
  notifyChannel: 'notify_channel',
};

const SETTING_DEFAULTS = {
  orgName: 'Horizon Property Group',
  notifyChannel: 'In-app push + email',
};

function readSettings() {
  const settings = {};
  Object.keys(SETTING_KEYS).forEach((name) => {
    const row = q.settingByKey().get(SETTING_KEYS[name]);
    settings[name] = row ? row.value : SETTING_DEFAULTS[name];
  });
  return settings;
}

router.use(authenticate);

// GET /api/settings - admin only. Read the stored workspace configuration.
router.get('/settings', authorize('admin'), (req, res) => {
  res.status(200).json({
    status: 'success',
    data: { settings: readSettings() },
  });
});

// PUT /api/settings - admin only. Validates and persists the configuration.
router.put('/settings', authorize('admin'), (req, res, next) => {
  const body = req.body || {};
  const orgName = typeof body.orgName === 'string' ? body.orgName.trim() : '';
  const notifyChannel = typeof body.notifyChannel === 'string'
    ? body.notifyChannel.trim()
    : '';

  if (orgName.length < 2 || orgName.length > 80) {
    return next(new AppError('Organisation name must be between 2 and 80 characters.', 400));
  }
  if (NOTIFY_CHANNELS.indexOf(notifyChannel) === -1) {
    return next(new AppError(`Unknown notification channel. Use one of: ${NOTIFY_CHANNELS.join(', ')}.`, 400));
  }

  q.upsertSetting().run(SETTING_KEYS.orgName, orgName);
  q.upsertSetting().run(SETTING_KEYS.notifyChannel, notifyChannel);

  logger.info('System settings updated', { adminId: req.user.id, orgName });
  res.status(200).json({
    status: 'success',
    message: 'Settings saved.',
    data: { settings: readSettings() },
  });
});

module.exports = router;
