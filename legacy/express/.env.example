# Copy this file to .env, then fill in real values.
# NEVER commit the real .env file (it is git-ignored).
#
#   bash:        cp .env.example .env
#   PowerShell:  Copy-Item .env.example .env

# Port the server listens on. Render injects PORT automatically.
PORT=8124

# JWT signing secret. OPTIONAL -- if you leave this unset the server generates a
# random 64-character secret at boot and carries on, so nothing has to be
# configured. Supply one only to keep sessions alive across restarts; if you do,
# it must be 32+ characters or startup is refused.
# Generate a strong one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# JWT expiry
JWT_EXPIRES_IN=2h

# development | production | test
NODE_ENV=development

# SQLite database file path (relative to the repo root).
# Use :memory: to run with an in-memory database (used by the test suite).
# Render's Free plan has an ephemeral filesystem, so its Blueprint points this at
# /tmp/propcare.db and the app reseeds itself on every cold start.
DB_PATH=data/propcare.db

# Demo account password baked into the seeded database.
# This is a PUBLIC demo credential for fictional sample data, not a secret.
# It is pinned in render.yaml because Free instances have no shell to read a
# generated password from.
DEMO_PASSWORD=PropCare123!